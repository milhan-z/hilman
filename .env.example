# ── Supabase ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by `npm run seed` and never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only. Used by /api/cloudinary/sign for signed uploads.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site ──────────────────────────────────────────────────
# The public origin, no trailing slash. This builds every absolute URL the
# site publishes: metadataBase, og:image, twitter:image, robots.txt, sitemap.
# It MUST be set in the Vercel project too — a production build without it
# advertises http://localhost:3000 to crawlers and social previews.
# e.g. https://hilaz.vercel.app
NEXT_PUBLIC_SITE_URL=https://hilaz.vercel.app

# ── Studio PIN sign-in ────────────────────────────────────
# Server-only, and never sent to the browser. Signing in with the PIN makes the
# server sign in to Supabase with the credentials below, so RLS and
# is_site_owner() still decide what may actually be written.
#
# A 6-digit PIN is a million combinations, which is weak on its own — five
# wrong tries lock the door for 15 minutes. Avoid birthdays and other dates.
# Leave STUDIO_PIN empty to turn PIN sign-in off; the email form always works.
STUDIO_PIN=
# The owner account the PIN unlocks — the same email and password you would
# have typed on the login screen.
STUDIO_OWNER_EMAIL=
STUDIO_OWNER_PASSWORD=
