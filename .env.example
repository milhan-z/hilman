# ── Supabase ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by `npm run seed`, `npm run owner`, and the PIN lockout
# counter, and never shipped to the client. Without it the studio still runs,
# but wrong-PIN attempts are only counted in memory — which on a serverless
# host means the lockout resets on every cold start. Set it in production.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only. Used by /api/cloudinary/sign for signed uploads.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site ──────────────────────────────────────────────────
# The public origin, no trailing slash. This builds every absolute URL the
# site publishes: metadataBase, og:image, twitter:image, robots.txt, sitemap.
# It MUST be set in the Vercel project too — a production build without it
# advertises http://localhost:3000 to crawlers and social previews.
# e.g. https://hilaz.vercel.app
NEXT_PUBLIC_SITE_URL=https://hilaz.vercel.app

# ── Studio PIN sign-in ────────────────────────────────────
# Server-only, and never sent to the browser. Signing in with the PIN makes the
# server sign in to Supabase with the credentials below, so RLS and
# is_site_owner() still decide what may actually be written.
#
# A 6-digit PIN is a million combinations, which is weak on its own. Wrong
# tries are counted twice: five per address, and twenty across the whole site,
# each locking the door for 15 minutes. The counts live in the database (see
# migration 0006), so they survive a restart. Avoid birthdays and other dates.
# Leave STUDIO_PIN empty to turn PIN sign-in off; the email form always works.
STUDIO_PIN=
# The owner account the PIN unlocks — the same email and password you would
# have typed on the login screen.
STUDIO_OWNER_EMAIL=
STUDIO_OWNER_PASSWORD=
